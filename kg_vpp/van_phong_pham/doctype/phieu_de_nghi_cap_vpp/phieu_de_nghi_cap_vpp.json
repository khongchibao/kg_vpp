            "fieldtype": "Link",
            "options": "User",
            "default": "__user",
            "reqd": 1
        },
        {
            "fieldname": "bo_phan",
            "label": "Bộ phận",
            "fieldtype": "Link",
            "options": "Bo Phan VPP",
            "reqd": 1
        },
        {
            "fieldname": "chi_tiet_vat_tu",
            "label": "Chi tiết vật tư",
            "fieldtype": "Table",
            "options": "Chi Tiet De Nghi VPP",
            "reqd": 1
        },
        {
            "fieldname": "nguoi_nhan_phieu",
            "label": "Người nhận phiếu",
            "fieldtype": "Link",
            "options": "User",
            "reqd": 0
        },
        {
            "fieldname": "ngay_nhan_phieu",
            "label": "Ngày nhận phiếu",
            "fieldtype": "Date",
            "reqd": 0
        },
        {
            "fieldname": "ghi_chu",
            "label": "Ghi chú",
            "fieldtype": "Small Text",
            "reqd": 0
        }
    ],
    "permissions": [
