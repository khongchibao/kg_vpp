{
    "name": "Phieu De Nghi Cap VPP",
    "doctype": "DocType",
    "module": "Van Phong Pham",
    "engine": "InnoDB",
    "autoname": "naming_series:",
    "naming_rule": "By \"Naming Series\" field",
